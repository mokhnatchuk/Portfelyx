# Project specific R8 keep rules for Portfelyx.
# AGP combines all .keep files in app/src/main/keepRules and passes them to R8.

# Keep annotations, generic signatures, and inner classes needed by Retrofit and kotlinx.serialization
-keepattributes *Annotation*, Signature, InnerClasses, RuntimeVisibleAnnotations, RuntimeVisibleParameterAnnotations, Exceptions
-dontnote kotlinx.serialization.AnnotationsKt

# Keep kotlinx.serialization runtime Companion and serializer() entry points
-keepclassmembers class kotlinx.serialization.json.** {
    *** Companion;
}
-keepclasseswithmembers class kotlinx.serialization.json.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# Keep @Serializable API models, their Companion objects, and generated $serializer classes
-keep,includedescriptorclasses class com.apps.portfelyx.CoinResponse { *; }
-keep,includedescriptorclasses class com.apps.portfelyx.CoinResponse$** { *; }
-keep,includedescriptorclasses class com.apps.portfelyx.MarketDataResponse { *; }
-keep,includedescriptorclasses class com.apps.portfelyx.MarketDataResponse$** { *; }
-keep,includedescriptorclasses class com.apps.portfelyx.CoinDetailResponse { *; }
-keep,includedescriptorclasses class com.apps.portfelyx.CoinDetailResponse$** { *; }
-keep,includedescriptorclasses class com.apps.portfelyx.SearchCoinItem { *; }
-keep,includedescriptorclasses class com.apps.portfelyx.SearchCoinItem$** { *; }
-keep,includedescriptorclasses class com.apps.portfelyx.CoinSearchResponse { *; }
-keep,includedescriptorclasses class com.apps.portfelyx.CoinSearchResponse$** { *; }

-if @kotlinx.serialization.Serializable class **
-keepclassmembers class <1> {
    static <1>$Companion Companion;
}
-if @kotlinx.serialization.Serializable class **
-keepclassmembers class <1>$Companion {
    kotlinx.serialization.KSerializer serializer(...);
}
-if @kotlinx.serialization.Serializable class **
-keep class <1>$*$serializer {
    *;
}

# Keep Retrofit CoinGeckoApi interface, suspend methods, and Kotlin default-parameter bridge
-keep,allowobfuscation,allowshrinking interface retrofit2.Call
-keep,allowobfuscation,allowshrinking class retrofit2.Response

-keep,includedescriptorclasses interface com.apps.portfelyx.CoinGeckoApi {
    <methods>;
}
-keep,includedescriptorclasses class com.apps.portfelyx.CoinGeckoApi$DefaultImpls {
    <methods>;
}
